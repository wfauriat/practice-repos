{
  "pytest fixture": {
    "prefix": "pyfix",
    "body": [
      "@pytest.fixture",
      "def ${1:name}():",
      "    ${2:# arrange}",
      "    yield ${3:value}",
      "    ${4:# teardown}"
    ],
    "description": "Pytest fixture with yield-based teardown."
  },
  "parametrize": {
    "prefix": "pyparam",
    "body": [
      "@pytest.mark.parametrize(\"${1:input}, ${2:expected}\", [",
      "    (${3:case_in}, ${4:case_out}),",
      "])",
      "def test_${5:name}(${1}, ${2}):",
      "    assert ${6:func}(${1}) == ${2}"
    ],
    "description": "Pytest parametrized test."
  },
  "dataclass": {
    "prefix": "pydc",
    "body": [
      "@dataclass",
      "class ${1:Name}:",
      "    ${2:field}: ${3:str}"
    ],
    "description": "Dataclass."
  },
  "if main": {
    "prefix": "pymain",
    "body": [
      "if __name__ == \"__main__\":",
      "    ${1:main()}"
    ],
    "description": "Standard __main__ guard."
  },
  "logger": {
    "prefix": "pylog",
    "body": [
      "import logging",
      "logger = logging.getLogger(__name__)"
    ],
    "description": "Module-level logger."
  },
  "TUTOR marker": {
    "prefix": "tutor",
    "body": "# TUTOR: ${1:hint}",
    "description": "Mark a blank for the fill-in-the-blanks tutorial protocol."
  }
}
