default:
    @just --list

install:
    python -m venv .venv
    .venv/bin/pip install -r requirements-dev.txt

# Run the EDA notebook end-to-end (good for CI)
nb:
    .venv/bin/jupyter nbconvert --to notebook --execute notebooks/01-eda.ipynb --output 01-eda.executed.ipynb

# Open Jupyter Lab
lab:
    .venv/bin/jupyter lab notebooks/

test:
    .venv/bin/pytest -v

lint:
    .venv/bin/ruff check src tests
    .venv/bin/ruff format --check src tests

freeze:
    .venv/bin/pip freeze > requirements.lock.txt
